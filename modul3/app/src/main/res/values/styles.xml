<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Style induk (wajib ada karena nama turunan memakai awalan "TeknisiGo.") -->
    <style name="TeknisiGo" />

    <style name="TeknisiGo.Title">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="TeknisiGo.Subtitle">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#CCFFFFFF</item>
    </style>

    <style name="TeknisiGo.Section">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TeknisiGo.Badge">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@color/accent</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="TeknisiGo.GridLabel">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">6dp</item>
    </style>

</resources>